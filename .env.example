# Optional. Overrides the public address (canonical links, sitemap, social cards, share link),
# which is https://www.usespot.fun (SITE_URL in src/lib/site.ts).
NEXT_PUBLIC_SITE_URL=
# Shown on /privacy as the address people write to about their data. Required before launch.
NEXT_PUBLIC_CONTACT_EMAIL=
# The person or company that runs Spot, named in the footer, on /privacy and on /terms. Required before launch.
NEXT_PUBLIC_OPERATOR=

# Set by Vercel when the Blob store is connected to the project (OIDC). The list lives there.
# `vercel env pull` writes it with a short-lived VERCEL_OIDC_TOKEN. A BLOB_READ_WRITE_TOKEN works instead.
BLOB_STORE_ID=

# Set by Vercel's Upstash for Redis integration. The line (places, referral codes) lives here.
# Upstash's own names, UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN, work too.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: a note to ourselves for each new signup, and the rescue mail if the store is down.
# MAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
MAIL_FROM=
OPS_INBOX=

# The app's API (/api/resolve, /api/sniff). All optional; see src/engine/README.md.
# Jupiter (developers.jup.ag): with a key, api.jup.ag and Swap V2's /order; without, lite-api.jup.ag.
JUPITER_API_KEY=
# The Jupiter plan's requests per second (with a key, 1 unless set; 10 on Developer).
JUPITER_RPS=
# A Solana RPC that answers getAccountInfo (Helius, Triton, QuickNode). Defaults to the public one.
SOLANA_RPC_URL=
# Where the warn line sits (defaults $7,500 liquidity, 150 holders, a 2-hour-old pool),
# and the most a warned coin can be bought for, in USDC (default 50).
SPOT_GATE_MIN_LIQUIDITY_USD=
SPOT_GATE_MIN_HOLDERS=
SPOT_GATE_MIN_POOL_AGE_HOURS=
SPOT_WARN_CAP_USDC=
# Opens /api/order and /api/execute (buying and selling through Jupiter). Leave unset until
# the fee, the wallet and the legal read are settled.
SPOT_TRADING=
# With SPOT_TRADING=1: only these wallets (addresses, comma separated) get an order. Testing
# with real money on your own wallets before anyone else can trade.
SPOT_TRADING_WALLETS=
# Lets /api/stats?key=… show the daily counts (engine/tally.ts). Unset: the route does not exist.
SPOT_STATS_KEY=

# Invites (README, "Inviting people"). The owner's page at /admin, and the
# link each phone's invite opens; a phone with no link is not invited yet.
# Mail goes through Resend: RESEND_API_KEY and MAIL_FROM above.
SPOT_ADMIN_KEY=
INVITE_URL_ANDROID=
INVITE_URL_SEEKER=
INVITE_URL_IPHONE=
# Optional: where replies go (else OPS_INBOX), and a postal address for the footer.
MAIL_REPLY_TO=
MAIL_POSTAL_ADDRESS=

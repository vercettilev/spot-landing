# Public address once the domain is picked (canonical links, sitemap, social cards, share link).
NEXT_PUBLIC_SITE_URL=https://example.com
# Shown on /privacy as the address people write to about their data. Required before launch.
NEXT_PUBLIC_CONTACT_EMAIL=

# Set by Vercel when a Blob store is connected to the project. The list lives here.
BLOB_READ_WRITE_TOKEN=

# Optional: a note to ourselves for each new signup, and the rescue mail if the store is down.
# MAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
MAIL_FROM=
OPS_INBOX=
